---
import { pricingPackages, siteContent } from '../data/mockData';
---

<section id="paquetes" class="section-space scroll-mt-24">
	<div class="page-container">
		<div class="max-w-2xl">
			<p class="eyebrow text-petrol">{siteContent.pricing.eyebrow}</p>
			<h2 class="section-title mt-4">{siteContent.pricing.title}</h2>
			<p class="mt-4 leading-7 text-zinc-600">{siteContent.pricing.description}</p>
		</div>

		<div class="mt-10 grid items-stretch gap-4 lg:grid-cols-3">
			{pricingPackages.map((offer) => (
				<article class={`flex flex-col border bg-white p-6 sm:p-7 ${offer.recommended ? 'border-petrol' : 'border-zinc-200'}`}>
					<div class="flex min-h-7 items-start justify-between gap-3">
						<p class="eyebrow text-petrol">TARIFA DE APERTURA</p>
						{offer.recommended && (
							<span class="shrink-0 border border-petrol px-2 py-1 text-[10px] font-medium uppercase tracking-wide text-petrol">
								{siteContent.pricing.recommendedLabel}
							</span>
						)}
					</div>
					<h3 class="mt-5 font-display text-xl font-semibold tracking-tight text-zinc-900">{offer.name}</h3>
					<p class="mt-5 font-display text-3xl font-semibold tracking-tight text-zinc-900">{offer.price}</p>
					{offer.payment && <p class="mt-1 text-sm text-zinc-600">{offer.payment}</p>}
					{offer.delivery && (
						<p class="mt-4 border-t border-zinc-200 pt-4 text-sm text-zinc-600">
							{siteContent.pricing.deliveryLabel} <span class="font-medium text-zinc-900">{offer.delivery}</span>
						</p>
					)}
					<div class="mt-5 flex-1 border-t border-zinc-200 pt-4">
						<p class="text-sm font-medium text-zinc-900">{siteContent.pricing.includesLabel}</p>
						<ul class="mt-3 space-y-3">
							{offer.includes.map((item) => (
								<li class="flex gap-2.5 text-sm leading-6 text-zinc-600">
									<span class="mt-0.5 text-petrol" aria-hidden="true">✓</span>
									<span>{item}</span>
								</li>
							))}
						</ul>
					</div>
					<a
						class={`button mt-7 w-full ${offer.recommended ? 'button-primary' : 'button-secondary'}`}
						href={offer.whatsappUrl}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`Cotizar el paquete ${offer.name} por WhatsApp`}
					>
						{siteContent.pricing.quoteAction} <span aria-hidden="true">↗</span>
					</a>
				</article>
			))}
		</div>
		<p class="mt-6 max-w-4xl text-xs leading-5 text-zinc-600">{siteContent.pricing.note}</p>
	</div>
</section>
