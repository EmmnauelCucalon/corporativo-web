---
import { contactInfo, siteContent } from '../data/mockData';
---

<section id="inicio" class="hero-section scroll-mt-24 border-b border-slate-200">
	<div class="page-container grid min-h-[590px] items-center gap-12 py-20 lg:grid-cols-[minmax(0,1.15fr)_minmax(280px,0.85fr)] lg:py-28">
		<div class="max-w-3xl">
			<p class="eyebrow font-mono text-xs uppercase tracking-wider">{siteContent.hero.eyebrow}</p>
			<h1 class="mt-7 font-display text-4xl font-bold leading-[1.12] tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
				{siteContent.hero.title}
			</h1>
			<p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
				{siteContent.hero.description}
			</p>
			<div class="mt-9 flex flex-wrap gap-3">
				<a class="button button-primary" href="#paquetes">{siteContent.hero.primaryAction}</a>
				<a
					class="button button-secondary"
					href={contactInfo.whatsappUrl}
					target="_blank"
					rel="noopener noreferrer"
				>
					{siteContent.hero.secondaryAction} <span aria-hidden="true">↗</span>
				</a>
			</div>
		</div>

		<div class="hidden border-l border-slate-200 py-5 pl-10 lg:block">
			<p class="font-display text-5xl font-semibold tracking-tight text-slate-900">CS<span class="text-blue-600">.</span></p>
			<p class="mt-6 max-w-xs text-sm leading-7 text-slate-600">
				{siteContent.hero.supportingNote}
			</p>
			<div class="mt-8 h-px w-16 bg-blue-600"></div>
			<p class="mt-4 font-mono text-xs uppercase tracking-wider text-slate-600">{contactInfo.shortLocation}</p>
		</div>
	</div>
</section>
