---
---

<section id="inicio" class="hero-section scroll-mt-24">
	<div class="page-container grid items-center gap-14 py-20 md:py-28 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
		<div class="max-w-2xl">
			<p class="eyebrow"><span class="mr-2 inline-block size-2 rounded-full bg-accent"></span>ESTRATEGIA DIGITAL · DESARROLLO WEB</p>
			<h1 class="mt-7 text-balance text-5xl font-semibold leading-[1.05] tracking-[-0.055em] text-ink sm:text-6xl lg:text-[4.35rem]">
				Tu próximo sitio web debería trabajar tan duro como tu equipo.
			</h1>
			<p class="mt-7 max-w-xl text-lg leading-8 text-muted">
				Diseñamos y desarrollamos plataformas digitales que cargan rápido, convierten mejor y crecen al ritmo de tu negocio.
			</p>
			<div class="mt-9 flex flex-wrap items-center gap-3">
				<a class="button button-dark" href="#contacto">Cotizar proyecto <span aria-hidden="true">↗</span></a>
				<a class="button button-light" href="#proyectos">Ver portafolio <span aria-hidden="true">↓</span></a>
			</div>
			<div class="mt-12 flex flex-wrap gap-x-8 gap-y-3 border-t border-ink/10 pt-6 text-sm text-muted">
				<span><strong class="mr-1.5 text-ink">100%</strong> enfocados en resultados</span>
				<span><strong class="mr-1.5 text-ink">Jamstack</strong> rápido y escalable</span>
			</div>
		</div>

		<div class="hero-visual relative mx-auto w-full max-w-[540px]" aria-label="Vista previa de una plataforma digital" role="img">
			<div class="absolute -left-7 top-12 hidden rounded-2xl border border-ink/8 bg-white p-4 shadow-xl shadow-ink/5 sm:block">
				<p class="text-xs font-medium text-muted">Rendimiento web</p>
				<div class="mt-2 flex items-end gap-2">
					<span class="text-3xl font-semibold tracking-tight text-ink">98</span>
					<span class="mb-1 text-xs text-accent">+12%</span>
				</div>
				<div class="mt-3 flex h-8 items-end gap-1">
					<span class="h-3 w-2 rounded-sm bg-accent/25"></span>
					<span class="h-5 w-2 rounded-sm bg-accent/40"></span>
					<span class="h-4 w-2 rounded-sm bg-accent/35"></span>
					<span class="h-7 w-2 rounded-sm bg-accent/60"></span>
					<span class="h-5 w-2 rounded-sm bg-accent/50"></span>
					<span class="h-8 w-2 rounded-sm bg-accent"></span>
				</div>
			</div>

			<div class="overflow-hidden rounded-[2rem] border border-ink/10 bg-white p-3 shadow-2xl shadow-ink/10">
				<div class="rounded-[1.5rem] bg-[#edf1ed] p-5 sm:p-7">
					<div class="flex items-center justify-between">
						<div class="flex items-center gap-2">
							<span class="size-2.5 rounded-full bg-accent"></span>
							<span class="text-xs font-semibold tracking-wide text-ink">MENDIETA</span>
						</div>
						<div class="flex gap-1.5" aria-hidden="true">
							<span class="size-1.5 rounded-full bg-ink/20"></span>
							<span class="size-1.5 rounded-full bg-ink/20"></span>
							<span class="size-1.5 rounded-full bg-ink/20"></span>
						</div>
					</div>
					<div class="mt-8 grid min-h-[310px] overflow-hidden rounded-2xl bg-[#dce6dd] sm:grid-cols-[1.1fr_0.9fr]">
						<div class="flex flex-col justify-center p-6 sm:p-7">
							<p class="text-[10px] font-semibold tracking-[0.18em] text-accent">CIENCIA PARA TU BIENESTAR</p>
							<p class="mt-4 text-3xl font-medium leading-tight tracking-[-0.04em] text-ink">La salud empieza con respuestas.</p>
							<span class="mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-ink px-4 py-2 text-[10px] font-medium text-white">Conoce nuestros servicios <span aria-hidden="true">→</span></span>
						</div>
						<div class="hero-art relative hidden sm:block" aria-hidden="true">
							<div class="absolute -right-10 top-12 size-56 rounded-full border-[32px] border-white/50"></div>
							<div class="absolute right-8 top-20 size-36 rounded-full bg-[#9cb5a1]"></div>
							<div class="absolute bottom-0 right-0 h-36 w-40 rounded-tl-[5rem] bg-[#486b54]"></div>
							<div class="absolute bottom-8 right-16 h-28 w-16 rotate-12 rounded-[50%] bg-[#c4d2c5]"></div>
						</div>
					</div>
					<div class="mt-4 flex items-center justify-between border-t border-ink/10 pt-4 text-[10px] text-muted">
						<span>Diagnóstico · Prevención · Confianza</span>
						<span>01 / 04</span>
					</div>
				</div>
			</div>

			<div class="absolute -bottom-5 right-4 rounded-2xl border border-ink/8 bg-white px-4 py-3 shadow-xl shadow-ink/5 sm:right-[-18px]">
				<p class="text-xs text-muted">Experiencia digital</p>
				<p class="mt-1 text-sm font-semibold text-ink"><span class="mr-1.5 text-accent">●</span>Hecha para crecer</p>
			</div>
		</div>
	</div>
</section>
