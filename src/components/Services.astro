---
import { services } from '../data/mockData';
---

<section id="servicios" class="section-space scroll-mt-20 bg-white">
	<div class="page-container">
		<div class="section-heading">
			<p class="eyebrow">LO QUE HACEMOS</p>
			<div class="mt-4 flex flex-col justify-between gap-5 md:flex-row md:items-end">
				<h2 class="section-title max-w-2xl">Tecnología que resuelve problemas reales de negocio.</h2>
				<p class="max-w-sm text-base leading-7 text-muted">Un equipo estratégico y técnico para acompañar cada etapa de tu transformación digital.</p>
			</div>
		</div>

		<div class="mt-14 grid gap-4 md:grid-cols-3">
			{services.map((service, index) => (
				<article class={`service-card ${index === 1 ? 'service-card-featured' : ''}`}>
					<div class="flex items-center justify-between">
						<span class="service-icon" aria-hidden="true">{service.number}</span>
						<span class="text-xs font-medium tracking-wide text-muted">{service.label}</span>
					</div>
					<h3 class="mt-9 text-xl font-semibold tracking-tight text-ink">{service.title}</h3>
					<p class="mt-3 text-sm leading-6 text-muted">{service.description}</p>
					<a class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-ink transition-colors hover:text-accent" href="#contacto">
						Conocer más <span aria-hidden="true">↗</span>
					</a>
				</article>
			))}
		</div>
	</div>
</section>
