---
import { processSteps, siteContent } from '../data/mockData';
---

<section id="proceso" class="section-space scroll-mt-24">
	<div class="page-container">
		<div class="max-w-2xl">
			<p class="eyebrow font-mono text-xs uppercase tracking-wider">{siteContent.process.eyebrow}</p>
			<h2 class="section-title mt-4">{siteContent.process.title}</h2>
			<p class="mt-4 leading-7 text-slate-600">{siteContent.process.description}</p>
		</div>

		<ol class="mt-10 grid border-l border-t border-slate-200 sm:grid-cols-2 lg:grid-cols-4">
			{processSteps.map((step) => (
				<li class="min-h-[205px] border-b border-r border-slate-200 p-5 sm:p-6">
					<span class="font-mono text-xs uppercase tracking-wider text-blue-600">{step.number}</span>
					<h3 class="mt-8 font-display text-lg font-semibold tracking-tight text-slate-900">{step.title}</h3>
					<p class="mt-3 text-sm leading-6 text-slate-600">{step.description}</p>
				</li>
			))}
		</ol>
	</div>
</section>
