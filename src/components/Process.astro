---
const phases = [
	{
		number: '01',
		title: 'Diagnóstico',
		description: 'Entendemos tus objetivos, procesos y audiencia antes de proponer una solución.',
	},
	{
		number: '02',
		title: 'Diseño',
		description: 'Definimos la experiencia, el contenido y la dirección visual de tu plataforma.',
	},
	{
		number: '03',
		title: 'Desarrollo Jamstack',
		description: 'Construimos una web rápida, segura y preparada para integrarse con tus herramientas.',
	},
	{
		number: '04',
		title: 'Despliegue y escalado',
		description: 'Publicamos, medimos y mejoramos el producto contigo después del lanzamiento.',
	},
];
---

<section id="proceso" class="section-space scroll-mt-20 bg-ink text-white">
	<div class="page-container">
		<div class="section-heading">
			<p class="eyebrow text-white/55">CÓMO TRABAJAMOS</p>
			<div class="mt-4 flex flex-col justify-between gap-5 md:flex-row md:items-end">
				<h2 class="section-title max-w-2xl text-white">Un proceso claro. Cero sorpresas.</h2>
				<p class="max-w-sm text-base leading-7 text-white/60">Colaboración cercana y decisiones informadas, desde la primera conversación hasta el crecimiento.</p>
			</div>
		</div>

		<ol class="mt-14 grid gap-0 border-t border-white/15 sm:grid-cols-2 lg:grid-cols-4">
			{phases.map((phase) => (
				<li class="process-step border-b border-white/15 py-7 sm:pr-7 lg:border-b-0 lg:border-r lg:px-7 lg:first:pl-0 lg:last:border-r-0 lg:last:pr-0">
					<span class="text-xs font-medium tracking-[0.16em] text-[#a6c4ac]">{phase.number}</span>
					<h3 class="mt-8 text-lg font-medium text-white">{phase.title}</h3>
					<p class="mt-3 text-sm leading-6 text-white/60">{phase.description}</p>
				</li>
			))}
		</ol>
	</div>
</section>
