---
const links = [
	{ label: 'Servicios', href: '#servicios' },
	{ label: 'Proyectos', href: '#proyectos' },
	{ label: 'Proceso', href: '#proceso' },
];
---

<header class="sticky top-0 z-50 border-b border-ink/8 bg-paper/90 backdrop-blur-md">
	<nav class="page-container flex h-[76px] items-center justify-between" aria-label="Navegación principal">
		<a class="flex items-center gap-2.5 font-semibold tracking-tight text-ink" href="#inicio" aria-label="Nexo Digital, inicio">
			<span class="grid size-9 place-items-center rounded-xl bg-ink text-sm font-bold text-white" aria-hidden="true">N</span>
			<span class="text-[17px]">nexo<span class="text-muted">.</span></span>
		</a>

		<div class="hidden items-center gap-9 text-sm text-muted md:flex">
			{links.map((link) => (
				<a class="transition-colors hover:text-ink" href={link.href}>{link.label}</a>
			))}
		</div>

		<a
			class="inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent"
			href="#contacto"
		>
			Hablemos <span aria-hidden="true">↗</span>
		</a>
	</nav>
</header>
