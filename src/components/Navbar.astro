---
import { contactInfo, navigationLinks, siteContent } from '../data/mockData';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-zinc-200 bg-stone-50/95 backdrop-blur-sm">
	<nav class="page-container flex min-h-[108px] flex-wrap content-center items-center justify-between gap-x-6 gap-y-3 md:h-[72px] md:min-h-0 md:flex-nowrap" aria-label="Navegación principal">
		<a class="font-display text-lg font-bold tracking-tight text-zinc-900" href="#inicio" aria-label={`${siteContent.name}, inicio`}>
			{siteContent.name}<span class="text-petrol">.</span>
		</a>

		<div class="order-3 flex w-full items-center justify-between gap-3 whitespace-nowrap text-xs text-zinc-600 md:order-none md:w-auto md:gap-7 md:text-sm">
			{navigationLinks.map((link) => (
				<a class="transition-colors hover:text-petrol" href={link.href}>{link.label}</a>
			))}
		</div>

		<a
			class="button button-primary shrink-0"
			href={contactInfo.whatsappUrl}
			target="_blank"
			rel="noopener noreferrer"
			aria-label={siteContent.contact.whatsappAction}
		>
			<span class="hidden sm:inline">{siteContent.contact.whatsappAction}</span>
			<span class="sm:hidden">{siteContent.contact.mobileWhatsappAction}</span>
			<span aria-hidden="true">↗</span>
		</a>
	</nav>
</header>
<div class="h-[109px] md:h-[73px]" aria-hidden="true"></div>
