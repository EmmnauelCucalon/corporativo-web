---
import ContactForm from './ContactForm';
import { contactInfo, siteContent } from '../data/mockData';
---

<section id="contacto" class="section-space scroll-mt-24 border-t border-zinc-200 bg-white">
	<div class="page-container grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
		<div class="max-w-md">
			<p class="eyebrow text-petrol">{siteContent.contact.eyebrow}</p>
			<h2 class="section-title mt-4">{siteContent.contact.title}</h2>
			<p class="mt-4 leading-7 text-zinc-600">{siteContent.contact.description}</p>

			<div class="mt-8 space-y-4 border-t border-zinc-200 pt-6">
				<a class="flex w-fit items-center gap-3 text-sm text-zinc-900 transition-colors hover:text-petrol" href={contactInfo.phoneHref}>
					<span class="w-20 text-zinc-600">{siteContent.contact.phoneLabel}</span>
					<span class="font-medium">{contactInfo.phone}</span>
				</a>
				<p class="flex items-center gap-3 text-sm text-zinc-900">
					<span class="w-20 text-zinc-600">{siteContent.contact.locationLabel}</span>
					<span class="font-medium">{contactInfo.location}</span>
				</p>
			</div>

			<a
				class="button button-primary mt-7"
				href={contactInfo.whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
			>
				{siteContent.contact.whatsappAction} <span aria-hidden="true">↗</span>
			</a>
		</div>

		<div class="border border-zinc-200 bg-stone-50 p-5 sm:p-8">
			<ContactForm client:visible endpoint={import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? ''} copy={siteContent.contact.form} />
		</div>
	</div>
</section>
