---
import { projects } from '../data/mockData';
---

<section id="proyectos" class="section-space scroll-mt-20">
	<div class="page-container">
		<div class="section-heading">
			<p class="eyebrow">TRABAJO SELECCIONADO</p>
			<div class="mt-4 flex flex-col justify-between gap-5 md:flex-row md:items-end">
				<h2 class="section-title max-w-xl">Resultados que se sienten en cada interacción.</h2>
				<p class="max-w-sm text-base leading-7 text-muted">Cada proyecto parte de una necesidad concreta y termina en una experiencia útil, clara y medible.</p>
			</div>
		</div>

		<div class="mt-14 grid gap-6 md:grid-cols-2">
			{projects.map((project, index) => (
				<article class={`project-card ${index === 0 ? 'md:col-span-2 md:grid md:grid-cols-[1.2fr_0.8fr]' : ''}`}>
					<div class={`project-image ${index === 0 ? 'project-image-featured' : ''}`}>
						<img src={project.image} alt={project.imageAlt} loading="lazy" />
						{index === 0 && (
							<div class="project-overlay-card" aria-hidden="true">
								<span class="text-[10px] font-semibold tracking-[0.18em] text-accent">LABORATORIO CLÍNICO</span>
								<p class="mt-2 text-lg font-medium tracking-tight text-ink">Resultados claros.<br />Atención cercana.</p>
								<span class="mt-4 inline-flex rounded-full bg-ink px-3 py-1.5 text-[10px] text-white">Solicitar examen ↗</span>
							</div>
						)}
						<span class="project-category">{project.category}</span>
					</div>
					<div class="flex flex-col justify-center py-5 md:px-2">
						<p class="eyebrow">{project.client}</p>
						<h3 class="mt-3 text-2xl font-semibold tracking-tight text-ink">{project.title}</h3>
						<p class="mt-3 max-w-lg text-sm leading-6 text-muted">{project.description}</p>
						<div class="mt-5 flex flex-wrap gap-2">
							{project.services.map((service) => (
								<span class="rounded-full border border-ink/10 px-3 py-1.5 text-xs text-muted">{service}</span>
							))}
						</div>
					</div>
				</article>
			))}
		</div>
	</div>
</section>
