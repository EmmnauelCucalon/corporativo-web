---
import { projects, siteContent } from '../data/mockData';
---

<section id="portafolio" class="section-space scroll-mt-24 border-y border-slate-200 bg-white">
	<div class="page-container">
		<div class="max-w-2xl">
			<p class="eyebrow font-mono text-xs uppercase tracking-wider">{siteContent.portfolio.eyebrow}</p>
			<h2 class="section-title mt-4">{siteContent.portfolio.title}</h2>
		</div>

		<div class="mt-10 grid gap-4 md:grid-cols-[1.35fr_0.65fr]">
			{projects.map((project) => (
				<article class="flex min-h-[300px] flex-col justify-between border border-slate-200 bg-slate-50 p-6 transition-colors hover:border-blue-600/50 sm:p-9">
					<div>
						<p class="eyebrow font-mono text-xs uppercase tracking-wider text-blue-600">{siteContent.portfolio.featuredLabel}</p>
						<p class="mt-6 font-mono text-xs uppercase tracking-wider text-slate-600">{project.industry}</p>
						<h3 class="mt-3 font-display text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">{project.name}</h3>
						<p class="mt-4 max-w-xl leading-7 text-slate-600">{project.description}</p>
					</div>
					<a
						class="mt-8 inline-flex w-fit items-center gap-2 border-b border-slate-900 pb-1 text-sm font-medium text-slate-900 transition-colors hover:border-blue-600 hover:text-blue-600"
						href={project.url}
						target="_blank"
						rel="noopener noreferrer"
					>
						{siteContent.portfolio.visitAction} <span aria-hidden="true">↗</span>
					</a>
				</article>
			))}
			<aside class="flex min-h-[220px] flex-col justify-between border border-slate-200 p-6 transition-colors hover:border-blue-600/50 sm:p-9">
				<div>
					<p class="eyebrow font-mono text-xs uppercase tracking-wider">{siteContent.name.toUpperCase()}</p>
					<p class="mt-5 max-w-xs font-display text-2xl font-semibold leading-snug tracking-tight text-slate-900">
						{siteContent.portfolio.futureCase}
					</p>
				</div>
				<a class="mt-8 text-sm font-medium text-blue-600 hover:text-slate-900" href="#contacto">
					{siteContent.portfolio.futureCaseAction} <span aria-hidden="true">↗</span>
				</a>
			</aside>
		</div>
	</div>
</section>
