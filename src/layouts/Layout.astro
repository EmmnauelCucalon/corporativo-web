---
import '../styles/global.css';
import { siteContent } from '../data/mockData';

interface Props {
	title?: string;
	description?: string;
}

const { title = siteContent.title, description = siteContent.description } = Astro.props;
---

<!doctype html>
<html lang="es-NI">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#FAFAF9" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_NI" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Plus+Jakarta+Sans:wght@600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="bg-stone-50 font-body text-zinc-900 antialiased">
		<slot />
	</body>
</html>
